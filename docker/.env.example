# =============================================================
# Patent Hermes Agent · Docker 环境变量
# 用法：cd docker && cp .env.example .env，然后把占位值填进去
# =============================================================

# -------- Docker 端口：宿主机映射（避开本机已占用端口） --------
DASHBOARD_HOST_PORT=9130
GATEWAY_HOST_PORT=8790
OUTPUT_HOST_PORT=9131

# -------- Docker 端口：容器内部（一般无需修改） --------
DASHBOARD_CONTAINER_PORT=9119
GATEWAY_CONTAINER_PORT=8765
OUTPUT_CONTAINER_PORT=9131

# -------- 主模型（MiniMax）--------
HERMES_MODEL_DEFAULT=MiniMax-M2.7
HERMES_MODEL_PROVIDER=minimax-cn
HERMES_MODEL_BASE_URL=https://api.minimaxi.com/anthropic
HERMES_MODEL_API_KEY=
OPENAI_API_KEY=
MINIMAX_CN_API_KEY=

# -------- 老张 API · GPT（OpenAI 协议）--------
LAOZHANG_OPENAI_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_OPENAI_API_KEY=
LAOZHANG_OPENAI_MODEL=gpt-4.1

# -------- 飞书机器人（patent 项目专用机器人） --------
FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_GROUP_POLICY=open
FEISHU_HOME_CHANNEL=
FEISHU_HOME_CHANNEL_THREAD_ID=
GATEWAY_ALLOW_ALL_USERS=true
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOWED_USERS=