# =============================================================
# Patent Hermes Agent · 本地运行环境变量
# 用法：cp .env.example .env，然后根据需要修改端口和密钥
# =============================================================

# -------- 本地端口 --------
DASHBOARD_PORT=9119
# 注意：本地模式下 GATEWAY_PORT 无法生效，hermes gateway 端口为内置默认值（8765）
# 该变量仅用于文档参考；Docker 模式下通过端口映射生效（见 docker/.env）
GATEWAY_PORT=8765
OUTPUT_PORT=9131

# -------- 主模型 --------
# 切换主模型：修改下面 4 个变量即可，然后执行 scripts/start.sh 重启。
# 可选值：
#   Kimi-K2.6: default=kimi-k2.6   provider=openrouter-kimi  base_url=https://openrouter.ai/api/v1
#   GPT-4.1:   default=gpt-4.1     provider=laozhang-openai  base_url=https://api.laozhang.ai/v1
#   GPT-5.1:   default=gpt-5.1     provider=laozhang-openai  base_url=https://api.laozhang.ai/v1
#   MiniMax:   default=MiniMax-M2.7 provider=minimax-cn       base_url=https://api.minimaxi.com/anthropic
HERMES_MODEL_DEFAULT=kimi-k2.6
HERMES_MODEL_PROVIDER=openrouter-kimi
HERMES_MODEL_BASE_URL=https://openrouter.ai/api/v1
HERMES_MODEL_API_KEY=              # ← 填入 OpenRouter API Key（同 OPENROUTER_KIMI_API_KEY）
OPENAI_API_KEY=

# -------- 备用模型 Key（供飞书 /model 命令切换时使用）--------

# OpenRouter · Kimi（OpenAI 协议 — 注册为自定义 provider openrouter-kimi）
OPENROUTER_KIMI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_KIMI_API_KEY=              # ← 填入 OpenRouter API Key
OPENROUTER_KIMI_MODEL=kimi-k2.6

# MiniMax（Hermes 内置 minimax-cn provider）
MINIMAX_CN_API_KEY=                # ← 填入 MiniMax 中国站 Key
MINIMAX_CN_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_CN_MODEL=MiniMax-M2.7

# 老张 API · GPT（OpenAI 协议 — 注册为自定义 provider laozhang-openai）
# 注意：base_url 必须以 /v1 结尾，否则 OpenAI SDK 无法正确拼接端点
LAOZHANG_OPENAI_BASE_URL=https://api.laozhang.ai/v1
LAOZHANG_OPENAI_API_KEY=              # ← 填入老张 API Key
LAOZHANG_OPENAI_MODEL=gpt-4.1

# -------- 飞书机器人 --------
# start.sh 会将这些变量同步到 ~/.hermes/.env，Gateway 启动后自动读取
FEISHU_ENABLED=true
FEISHU_APP_ID=                     # ← 填入飞书应用 App ID
FEISHU_APP_SECRET=                 # ← 填入飞书应用 App Secret
FEISHU_DOMAIN=feishu               # feishu 或 lark
FEISHU_CONNECTION_MODE=websocket
FEISHU_GROUP_POLICY=open
# 飞书主频道：用于接收定时任务(cron)结果和跨平台消息。
# 无需手动填写 chat_id，在飞书对话中发送 /sethome 即可自动设置为当前聊天。
#FEISHU_HOME_CHANNEL=
#FEISHU_HOME_CHANNEL_THREAD_ID=
GATEWAY_ALLOW_ALL_USERS=true
FEISHU_ALLOW_ALL_USERS=true
FEISHU_ALLOWED_USERS=
